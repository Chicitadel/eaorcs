{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eaorcs.ujomor.org/schemas/audit-attestation-v1.schema.json",
  "title": "EAORCS Audit Attestation Record Schema v1.0",
  "description": "Formal JSON Schema defining structure for cryptographically verifiable audit attestations and compliance records.",
  "type": "object",
  "required": [
    "attestationId",
    "timestamp",
    "auditor",
    "targetResource",
    "complianceFrameworks",
    "status",
    "signature"
  ],
  "properties": {
    "attestationId": {
      "type": "string",
      "pattern": "^attestation:[a-zA-Z0-9._-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "auditor": {
      "type": "object",
      "required": ["did", "name", "role"],
      "properties": {
        "did": { "type": "string", "pattern": "^did:eaorcs:[a-zA-Z0-9._-]+$" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "targetResource": {
      "type": "object",
      "required": ["resourceId", "type", "hash"],
      "properties": {
        "resourceId": { "type": "string" },
        "type": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "complianceFrameworks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["PASSED", "CONDITIONAL", "FAILED"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "description": { "type": "string" }
        }
      }
    },
    "signature": {
      "type": "string"
    }
  }
}
