{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EAORCS Trust Graph Schema v1",
  "type": "object",
  "required": ["version", "graph_id", "nodes", "edges", "timestamp"],
  "properties": {
    "version": { "type": "string", "default": "1.0.0" },
    "graph_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["Evidence", "Claim", "Verifier", "Policy", "Artifact", "Stream", "PRRGate"] },
          "label": { "type": "string" },
          "trust_weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "metadata": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relationship"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relationship": { "type": "string", "enum": ["validates", "verifies", "secures", "supports", "derivedFrom", "gates"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
