{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://airroofers.eu/schemas/osap-v1.json",
  "title": "OSAP v1 Open Standard",
  "description": "JSON Schema for OSAP (Open Standard for Architecture and Protocols) validation and compliance.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        }
      },
      "required": ["timestamp"]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": ["A", "B", "C"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "pending"]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": ["id", "level", "status"]
      }
    },
    "signatures": {
      "type": "object",
      "properties": {
        "ed25519": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        }
      }
    }
  },
  "required": ["version", "metadata", "requirements"]
}
